# Copy to .env.local and fill in. Never commit .env.local.

# Postgres (Supabase). The app uses the transaction pooler (port 6543); migrations use the
# session pooler (port 5432). Use a password of letters and digits (no URL encoding needed).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# File storage for 3D models (Cloudflare R2): an API token with Object Read & Write on the
# bucket. Leave empty in development to store files in .local-storage/.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Public base URL of this app
APP_URL="http://localhost:3000"
# Optional: other domains that also serve the app, comma-separated (e.g. "planlogic.vercel.app").
# Add each one's callback URLs on Google and Autodesk too.
APP_ALIASES=""

# Signs and encrypts sessions and stored OAuth tokens: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Autodesk Platform Services app (aps.autodesk.com > My Apps, type "Traditional Web App").
# Register this callback URL on the app: {APP_URL}/api/auth/callback/autodesk
APS_CLIENT_ID=""
APS_CLIENT_SECRET=""
# Globally unique OSS bucket for uploaded models (lowercase, digits, - _ .)
APS_BUCKET_KEY=""

# Optional: "Continue with Google" (console.cloud.google.com > APIs & Services > Credentials).
# Authorized redirect URI: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: maps (project pins, the projects map, models on photorealistic 3D tiles). In Google
# Cloud, enable the Maps JavaScript, Places (New), Map Tiles and Elevation APIs and create a key restricted
# to the app's websites; GOOGLE_MAP_ID is a JavaScript vector map id from Map Management.
GOOGLE_MAPS_API_KEY=""
GOOGLE_MAP_ID=""

# Optional: email sign-in links via Resend (resend.com). Without these, links are
# printed to the dev server console instead of being emailed (development only).
RESEND_API_KEY=""
EMAIL_FROM="Estimator <signin@yourdomain.com>"
